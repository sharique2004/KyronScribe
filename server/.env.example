# Kyron Scribe — server environment (local development).
# Copy to `.env` and fill in real values. `.env` is gitignored; NEVER commit secrets.
# In production these values are loaded from AWS Secrets Manager instead (see AWS_SECRETS_NAME).

# --- Database -------------------------------------------------------------
# Local Homebrew Postgres (trust auth). Include the OS user explicitly.
DATABASE_URL=postgres://localhost:5432/kyron_scribe

# --- Auth -----------------------------------------------------------------
# HS256 signing secret. Generate a long random value: `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-long-random-string
JWT_TTL_HOURS=12

# --- HTTP server ----------------------------------------------------------
PORT=4000
NODE_ENV=development

# --- AI scribe ------------------------------------------------------------
# Provider selection: AI_PROVIDER (gemini|anthropic|mock) wins when set; otherwise the
# server uses gemini if GEMINI_API_KEY is set, else anthropic if ANTHROPIC_API_KEY is
# set, else mock. Leave both keys blank (and/or SCRIBE_MOCK=1) to demo without a key.
# GEMINI_API_KEY: free at https://aistudio.google.com/apikey (generous free tier).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini
# SCRIBE_MODEL defaults per provider: gemini-3.6-flash (gemini) / claude-sonnet-5 (anthropic).
SCRIBE_MODEL=
SCRIBE_MOCK=1

# --- Transactional email (optional) ---------------------------------------
# Verified AWS SES sender for signup/approval notifications (region us-east-2).
# Leave blank to disable email entirely — signup/approval still succeed silently.
# Format: "Kyron Scribe <no-reply@your-domain.com>".
SES_FROM=

# --- Production secret loading (unset locally) ----------------------------
# When set, the server fetches this secret at boot via the EC2 instance role
# and its JSON values override anything above.
# AWS_SECRETS_NAME=kyron-scribe/prod
